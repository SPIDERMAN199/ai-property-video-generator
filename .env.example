# Server Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# AI Content Generation
# Provider options: "template" (default deterministic offline fallback), "gemini", "openai"
AI_PROVIDER=template
AI_API_KEY=

# Storage Settings
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=15

# Video Processing
# Leave empty to automatically use bundled FFmpeg via imageio-ffmpeg or system PATH
FFMPEG_PATH=
